{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "0.3.0",
  "description": "抓取网页 LLM 会话消息并自诊断 DOM 结构，转发到本地 agent 接收端 (localhost:8787)",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "http://localhost:8787/*",
    "https://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "http://localhost/*"
      ],
      "js": ["project_id.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["project_id.js", "panel.js"],
      "run_at": "document_idle"
    }
  ]
}
